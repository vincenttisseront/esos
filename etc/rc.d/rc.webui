#! /bin/sh

# ESOS WebUI. The HTTP server is loopback-only (127.0.0.1:3000).
# A host override is intentionally not accepted.

source /etc/rc.d/common

NODE="/usr/bin/node"
WEBUI_DIR="/usr/local/lib/esos-webui"
SERVER="${WEBUI_DIR}/server/index.mjs"
LOCK="/var/lock/webui"
PIDFILE="/var/run/webui.pid"
LOG="/var/log/webui.log"

check_args ${@}

bundle_ready() {
    [ -x "${NODE}" ] && [ -f "${SERVER}" ]
}

start() {
    if ! bundle_ready; then
        /bin/echo "ESOS WebUI bundle is not installed; not starting."
        exit 0
    fi
    if [ -f "${PIDFILE}" ] && /usr/bin/ps -p "$(/bin/cat ${PIDFILE})" > /dev/null 2>&1; then
        /bin/echo "ESOS WebUI is already running."
        exit 0
    fi
    /bin/echo "Starting ESOS WebUI on 127.0.0.1:3000..."
    NITRO_HOST=127.0.0.1 HOST=127.0.0.1 NITRO_PORT=3000 \
        /usr/bin/nohup ${NODE} ${SERVER} >> ${LOG} 2>&1 &
    /bin/echo $! > ${PIDFILE}
    /bin/touch ${LOCK}
}

stop() {
    if [ ! -f "${PIDFILE}" ]; then
        /bin/echo "ESOS WebUI is not running."
        exit 0
    fi
    pid="$(/bin/cat ${PIDFILE})"
    /bin/echo "Stopping ESOS WebUI..."
    /bin/kill -TERM ${pid} || exit 1
    wait_for_pid_stop ${pid} && /bin/rm -f ${PIDFILE} ${LOCK}
}

status() {
    if [ -f "${PIDFILE}" ] && /usr/bin/ps -p "$(/bin/cat ${PIDFILE})" > /dev/null 2>&1; then
        exit ${RUNNING}
    fi
    exit ${STOPPED}
}

${1}
